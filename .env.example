# Copy to .env and fill in your values before starting the server.

# Port the Express server listens on (default: 3000)
PORT=3000

# Publicly reachable base URL for this server — used to construct image URLs
# that are stored in GoHighLevel (GHL must be able to fetch this URL).
SERVER_BASE_URL=https://your-server.example.com

# GoHighLevel API key (v2 — from Settings → Integrations → API Keys in your sub-account)
GHL_API_KEY=

# ID of the GHL custom field that will store the personalized image URL.
# Find it in Settings → Custom Fields (copy the field's internal ID, not its label).
GHL_CUSTOM_FIELD_ID=
